# Copy this file to .env.local and fill in real values from the Firebase
# console (Project settings → General → Your apps → SDK setup and config).
# Doclee runs fine without these — Firebase features (Analytics, and the
# Cloud Functions conversion stubs) simply no-op until they're supplied.

VITE_FIREBASE_API_KEY=
# Use the domain the app is actually served from (this project's Hosting site
# is "doclee", not the default site) — NOT the default <project>.firebaseapp.com.
# Firebase Hosting auto-serves the /__/auth/handler routes needed for this on
# any connected site. Using the wrong domain here causes signInWithRedirect to
# silently fail to persist across the redirect (browsers partition storage
# per-origin, so the authDomain and the app's real origin must match).
VITE_FIREBASE_AUTH_DOMAIN=doclee.web.app
VITE_FIREBASE_PROJECT_ID=doclee-imgconv
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
