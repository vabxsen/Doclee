rules_version = '2';

// No auth or data model exists in this build yet — everything is
// local-first (Zustand + IndexedDB) with no Firestore reads/writes wired up.
// Default-deny until a real data model and auth strategy are designed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
